# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Nansen disk cache (network responses only; committed seed lives in data/nansen-seed)
/.cache/

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example
progress/raw/aa-data/

# Telegram alarm store (chat bindings; not secret, but not build output either)
/data/alarms.json

# Persisted fills per address (incremental Nansen fetch cache; not secret, not seed data)
/data/fills/
