# ── Nansen ───────────────────────────────────────────────────
# Get from: https://app.nansen.ai/api  (only the live paths need it: `draw`, `card`, `seed`, `bench`, the web "Draw fresh")
# The deck, the tests and `npm run verify` run without a key. A live draw costs ≤ 13 credits.
NANSEN_API_KEY=nsn_your-key-here

# ── Optional ─────────────────────────────────────────────────
# Absolute origin used for Open Graph / Twitter image URLs (defaults to the canonical domain; https://labelme-edycutjong.vercel.app is the fallback alias)
# SITE_URL=https://labelme.edycu.dev

# Spend guard on the public /api/draw route (defaults shown; see apps/web/lib/guard.ts)
GUARD_IP_PER_MIN=4
GUARD_DAILY_CREDITS=600
